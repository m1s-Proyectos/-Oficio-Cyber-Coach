# Copia este archivo como .env.local y sustituye los valores de ejemplo.
# .env.local no se versiona. Ninguna de estas variables es un secreto, pero
# no publiques archivos .env reales.

# Deployment de desarrollo que usa la CLI (`npx convex dev`). Formato: dev:<nombre-del-deployment>
CONVEX_DEPLOYMENT=dev:nombre-de-ejemplo-123

# URL pública del deployment que lee el cliente React (Vite solo expone variables con prefijo VITE_).
VITE_CONVEX_URL=https://nombre-de-ejemplo-123.convex.cloud

# URL de HTTP actions. La escribe la CLI; la aplicación todavía no la usa.
VITE_CONVEX_SITE_URL=https://nombre-de-ejemplo-123.convex.site

# Solo el servidor Convex (action). No uses prefijo VITE_: el cliente no debe verlas.
# Configúralas en el deployment con autorización explícita. Valores de ejemplo, no reales.
# Cerrado por defecto: solo VOICE_ENABLED=true habilita síntesis. No uses 1/yes.
# VOICE_ENABLED=true
# ELEVENLABS_API_KEY=sk_ejemplo_no_usar
# ELEVENLABS_VOICE_ID=voiceid_ejemplo
# ELEVENLABS_MODEL_ID=model_ejemplo
